# این فایل را کپی کرده و به نام .env ذخیره کنید (فایل .env هرگز نباید commit شود)

# آدرس اتصال به MongoDB
MONGO_URL=mongodb://localhost:27017

# کلید مخفی JWT - برای production حتما یک مقدار تصادفی و امن بسازید:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret

# مدت اعتبار توکن ورود بر حسب دقیقه (پیش‌فرض ۲۴ ساعت)
JWT_EXPIRE_MINUTES=1440

# دامنه‌های مجاز برای CORS، با کاما جدا شوند. برای توسعه محلی می‌توان * گذاشت
CORS_ORIGINS=http://localhost:5500,https://myfrontend.com
